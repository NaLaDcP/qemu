# ── Stage build ───────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ninja-build \
    python3 \
    python3-pip \
    python3-tomli \
    pkg-config \
    git \
    libglib2.0-dev \
    libfdt-dev \
    libpixman-1-dev \
    zlib1g-dev \
    libmount-dev \
    libselinux1-dev \
    libatomic1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /qemu
COPY . .

RUN ./configure --target-list=aarch64-softmmu --disable-docs --disable-werror \
 && make -j$(nproc)

# ── Stage runtime ─────────────────────────────────────────────────────────────
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libfdt1 \
    libpixman-1-0 \
    zlib1g \
    libmount1 \
    libselinux1 \
    libatomic1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /qemu/build/qemu-system-aarch64 /usr/local/bin/
COPY --from=builder /qemu/pc-bios/ /usr/local/share/qemu/

RUN mkdir /logs /images \
 && printf '#!/bin/sh\nset -e\n\nif [ -z "$IMAGE_FILE" ]; then\n  echo "ERROR: IMAGE_FILE non défini"\n  exit 1\nfi\n\nexec qemu-system-aarch64 \\\n  -machine virt,virtualization=on \\\n  -cpu cortex-a53 \\\n  -device "loader,file=${IMAGE_FILE},addr=0x70000000,cpu-num=0" \\\n  -serial mon:stdio \\\n  -d guest_errors \\\n  -D /logs/qemu.log \\\n  -m size=2G \\\n  -nographic \\\n  "$@"\n' > /entrypoint.sh \
 && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
